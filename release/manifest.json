{
  "schema": "raden.release-manifest.v1",
  "package": {
    "name": "gpui-mbt/raden",
    "version": "0.1.0",
    "description": "MoonBit port of shiguredo/raden: CPU 2D vector graphics core",
    "license": "Apache-2.0",
    "upstream": {
      "repository": "https://github.com/shiguredo/raden",
      "commit": "afb752e17a69fef8af981251b68de22a7597ff01",
      "cargo_version": "2026.2.0"
    }
  },
  "targets": {
    "native": { "status": "verified", "os_arch": "linux x86_64" },
    "js": { "status": "verified", "runtime": "node v24" },
    "wasm": { "status": "not_verified" },
    "wasm-gc": { "status": "not_verified" },
    "windows": { "status": "not_verified" },
    "macos-apple-silicon": { "status": "not_verified" },
    "macos-intel": { "status": "out_of_scope" }
  },
  "features": {
    "declared": [
      "image/pixel/compositing (29 comp ops)",
      "geometry/path/affine",
      "analytic rasterization",
      "stroke (cap/join/miter/dash)",
      "gradient (linear/radial/conic) / pattern / blit",
      "font (TrueType glyf、GSUB Single/Ligature、GPOS Single/Pair、liga/kern/clig)",
      "text fill/stroke",
      "scene rendering (basic/gradient/stroke/blit_clip_pattern/animation)",
      "browser Vector Playground (M1: 固定参照比較)"
    ],
    "not_implemented": [
      "gpui native host (gpui@0.7.2 に画像 upload API なし、RADEN-0010 blocked)",
      "tiger scene (asset provenance 未確認)",
      "GPU 描画 / Cranelift JIT",
      "CFF/CFF2 フォント、縦書き、可変フォント、script 選択",
      "Playground M2/M3 編集 UI"
    ]
  },
  "verification": {
    "conformance": "conformance/run_conformance.sh — 95 fixture oracle 比較 (pixel + shapes meta)",
    "tests": "moon test --target native / js",
    "bench": "conformance/run_bench.sh — raden.bench-report.v1 (hash gate 付き)",
    "gate": "scripts/run_checks.sh + scripts/check_gate.py (fail-closed)",
    "consumer": "scripts/run_consumer_test.sh (独立 module、native/js)",
    "gate_fault_injection": "scripts/test_gate.sh"
  },
  "runtime_dependencies": [
    { "module": "moonbitlang/async", "version": "0.22.5", "scope": "fs/時刻のみ、pure core は不使用" }
  ],
  "assets": {
    "conformance/fonts/SourceSans3-Regular.ttf": {
      "license": "SIL OFL 1.1",
      "sha256_recorded": true,
      "note": "検証用フォント。再配布条件確認済み (OFL)。runtime 埋め込みなし"
    },
    "tiger_data": { "status": "pending_provenance_check", "included": false }
  },
  "publish": {
    "status": "not_executed",
    "note": "publish/deploy は明示的な実行判断を経る。本 manifest は配布手順の検証用"
  }
}
