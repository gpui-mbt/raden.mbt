import {
  "gpui-mbt/raden",
  "moonbitlang/core/cmp",
}

// フォント本体は pure (Bytes in → Path/メトリクス out)。
// ファイル I/O は host 層の責務であり、async/fs の依存はテストのみに限定する。
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
} for "wbtest"

options(
  targets: {
    // 実フォント読み込みテストは fs が native でのみ提供されるため
    "font_wbtest.mbt": [ "native" ],
  },
)
